# Build-time (public) settings — copy to .env.production and fill in.
# WalletConnect / Reown project id (https://cloud.reown.com). Optional: without it the
# WalletConnect option is hidden. Add your site's domain to the project's allowlist.
VITE_WC_PROJECT_ID=
# Optional RPC override for Robinhood Chain.
# VITE_RPC_URL=
